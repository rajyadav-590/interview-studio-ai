# AI provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database
DATABASE_URL=sqlite:///./interviewer.db
# Example MySQL:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/interview_studio

# Auth
JWT_SECRET=change-this-in-development

# App limits
ANSWER_RATE_LIMIT=5

# Frontend -> backend
VITE_API_URL=http://localhost:8000/api

# Production frontend URL
FRONTEND_URL=http://localhost:5173